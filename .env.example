# Required. Fine-grained personal access token, public repositories only
GITHUB_TOKEN=

# Required for the local database (docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Optional (defaults shown)
# GITHUB_USER_AGENT=issue-pulse/0.1 (+https://github.com/simon-dutka/issue-pulse)
# GITHUB_API_URL=https://api.github.com
# GITHUB_MIN_REMAINING_REQUESTS=20
